{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PortFinder",
  "version": "2026.4.15",
  "identifier": "com.packetthrower.portfinder",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "PortFinder",
        "width": 480,
        "height": 500,
        "minWidth": 400,
        "minHeight": 500,
        "backgroundColor": "#001825"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
