{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PortFinder",
  "version": "3.1.0",
  "identifier": "com.packetthrower.portfinder",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PortFinder",
        "width": 400,
        "height": 460,
        "minWidth": 360,
        "minHeight": 460,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "deb", "rpm", "appimage", "nsis"],
    "category": "Utility",
    "shortDescription": "Network switch port discovery via CDP/LLDP",
    "longDescription": "PortFinder captures CDP and LLDP packets to identify what switch, port, and VLAN your device is connected to.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libpcap0.8"],
        "postInstallScript": "scripts/postinstall.sh"
      },
      "rpm": {
        "depends": ["libpcap"],
        "postInstallScript": "scripts/postinstall.sh"
      }
    }
  }
}
