# yaml-language-server: $schema=https://aka.ms/winget-manifest.installer.1.6.0.schema.json
#
# Installer manifest template. Fill in:
#
#   ${VERSION}              SemVer, no leading `v` (e.g. `4.1.0`)
#   ${RELEASE_DATE}         ISO date the GitHub Release was cut
#   ${SHA256_AMD64_MSI}     `Get-FileHash -Algorithm SHA256` of the .msi
#   ${SHA256_ARM64_NSIS}    same for the ARM64 -setup.exe
#   ${PRODUCT_CODE_AMD64}   '{GUID}' extracted from the .msi (wingetcreate auto-detects)
#
# AMD64 ships both NSIS and WiX MSI on stable releases (per
# .github/workflows/release.yml's "Build .exe (NSIS) + .msi
# (stable amd64 only)" step); we prefer the .msi for winget
# because it has a ProductCode + clean Add/Remove Programs
# integration. ARM64 ships NSIS only (no WiX on ARM64 builds),
# so the arm64 entry uses `nullsoft` with explicit silent-mode
# switches.
#
# Pre-releases (`-beta`, `-alpha`) DON'T produce a .msi (only
# stable amd64 does), so this template is only viable for
# stable tags. Beta artifacts can still be installed via
# `winget install --manifest <path>` against a hand-edited
# manifest, but the upstream submission has to wait for stable.

PackageIdentifier: packetThrower.PortFinder
PackageVersion: ${VERSION}
ReleaseDate: ${RELEASE_DATE}
InstallModes:
  - interactive
  - silent
  - silentWithProgress
Installers:
  - Architecture: x64
    InstallerType: wix
    InstallerUrl: https://github.com/packetThrower/PortFinder/releases/download/v${VERSION}/PortFinder_${VERSION}_x64_en-US.msi
    InstallerSha256: ${SHA256_AMD64_MSI}
    ProductCode: '${PRODUCT_CODE_AMD64}'
    Scope: machine
  - Architecture: arm64
    InstallerType: nullsoft
    InstallerUrl: https://github.com/packetThrower/PortFinder/releases/download/v${VERSION}/PortFinder_${VERSION}_arm64-setup.exe
    InstallerSha256: ${SHA256_ARM64_NSIS}
    Scope: machine
    InstallerSwitches:
      Silent: /S
      SilentWithProgress: /S
ManifestType: installer
ManifestVersion: 1.6.0
